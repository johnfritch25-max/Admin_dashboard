{{> head}}

<body class="bg-slate-100 text-slate-800 font-sans antialiased">
  <div class="flex h-screen overflow-hidden">
    {{> aside}}

    <main class="flex-1 overflow-y-auto p-6">
      <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-200">
          <h2 class="text-lg font-bold text-slate-900">Products</h2>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase">
                <th class="px-6 py-3.5">ID</th>
                <th class="px-6 py-3.5">Name</th>
                <th class="px-6 py-3.5">Description</th>
                <th class="px-6 py-3.5">Category</th>
                <th class="px-6 py-3.5">Stock</th>
                <th class="px-6 py-3.5 text-right">Price</th>
              </tr>
            </thead>

            <tbody class="divide-y divide-slate-100 text-sm text-slate-700">
              {{#each products}}
              <tr class="hover:bg-slate-50">
                <td class="px-6 py-4">{{this.id}}</td>
                <td class="px-6 py-4 font-medium text-slate-900">{{this.name}}</td>
                <td class="px-6 py-4">{{this.description}}</td>
                <td class="px-6 py-4">{{this.category}}</td>
                <td class="px-6 py-4">{{this.stock}}</td>
                <td class="px-6 py-4 text-right">₱{{this.price}}</td>
              </tr>
              {{else}}
              <tr>
                <td colspan="6" class="px-6 py-4 text-center">
                  No products found.
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>
</body>